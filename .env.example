# Скопируй этот файл в .env и заполни значения.
# НЕ коммить .env в git.

# Telegram Bot token от @BotFather
TELEGRAM_BOT_TOKEN=

# Твой Telegram user ID (узнать через @userinfobot)
NAVISAN_OWNER_ID=

# Пути к директориям (абсолютные или относительные от корня проекта)
NAVISAN_INBOX=/inbox
NAVISAN_STAGING=/staging
NAVISAN_LIBRARY=/library

# Путь к базе данных Navidrome (read-only)
NAVISAN_DB=navidrome.db
